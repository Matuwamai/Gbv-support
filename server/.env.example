# Copy this file to .env and fill in your own values.
PORT=3000

# MySQL connection string used by Prisma
DATABASE_URL="mysql://USER:PASSWORD@localhost:3306/gbv_support"

# Secret used to sign login tokens (use a long random string)
JWT_SECRET="change-me-to-a-long-random-string"

# Public URL of this server, used to build links to uploaded media
BASE_URL=http://localhost:3000

# Comma-separated list of frontend origins allowed by CORS
CLIENT_ORIGIN=http://localhost:5173

# Twilio credentials for the emergency call feature
TWILIO_ACCOUNT_SID="your twilio account sid"
TWILIO_AUTH_TOKEN="your twilio auth token"
TWILIO_PHONE_NUMBER="+10000000000"

# Support lines that emergency calls are connected to (E.164 format)
EMERGENCY_NUMBER_SEXUAL_HARASSMENT="+254000000000"
EMERGENCY_NUMBER_DOMESTIC_VIOLENCE="+254000000000"
EMERGENCY_NUMBER_OTHER="+254000000000"
